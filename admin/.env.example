# ==========================================
# REZONI ISOLATED ADMIN PORTAL (admin.rezoni.shop)
# Environment Variables Template
# ==========================================

# 1. Administrator Credentials (Login ID & Password)
ADMIN_ID=admin@rezoni.shop
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_SESSION_SECRET=your_random_cryptographic_secret_here

# 2. Database Connection (Supabase Cloud PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 3. Main Store Domain
NEXT_PUBLIC_STORE_URL=https://rezoni.shop
