# ==============================================================================
# REZONI - Razorpay Payment Gateway Environment Variables
# ==============================================================================
# 1. Sign up or log into your Razorpay Dashboard: https://dashboard.razorpay.com
# 2. Go to Account & Settings -> API Keys (Generate Test or Live Key)
# 3. Paste the Key ID and Key Secret below.
# 4. In Razorpay Dashboard -> Webhooks:
#    Add endpoint: https://your-domain.com/api/razorpay/webhook
#    Events to subscribe: payment.captured, order.paid, payment.failed
#    Set your webhook secret below.
# ==============================================================================

# Public Key ID - used on client-side to initialize the Razorpay checkout popup modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

# Server-only Key ID and Secret - strictly secret, never exposed to client bundle
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# Optional Webhook Secret - for verifying webhook events from Razorpay server
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# ==============================================================================
# REZONI - Supabase Database Environment Variables
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

